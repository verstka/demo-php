# Verstka (https://packagist.org/packages/verstka/sdk)
VERSTKA_API_KEY=
VERSTKA_API_SECRET=
# Public URL of this app where Verstka POSTs callbacks (must end with path used by nginx)
VERSTKA_CALLBACK_URL=https://example.com/verstka/callback
VERSTKA_API_URL=https://api.r2.verstka.org/integration
VERSTKA_VIEWER_SCRIPT_URL=https://go.r2.verstka.org/viewer-latest.js

# Site
PUBLIC_BASE_URL=https://example.com
SESSION_SECRET=change-me-to-random-string
# DEBUG=1
# When enabled, logs each HTTP request/response to stderr. Do not use in production.

# SQLite (PDO DSN)
DATABASE_URL=sqlite:./data.db

# CMS login throttle (optional)
# CMS_LOGIN_MAX_FAILURES=10
# CMS_LOGIN_WINDOW_SECONDS=1800
