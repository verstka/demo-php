{
    "name": "verstka/demo-php",
    "description": "Minimal CMS with Verstka editor, SQLite, static nginx publishing",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "verstka/sdk": "^0.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}